<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reach your server, and the mic for calls. MODIFY_AUDIO_SETTINGS is a no-prompt permission
         WebView needs for mic capture. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether there's a network yet (Wi-Fi reconnecting as the screen wakes), before asking her. No prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Finished-reply and scheduled-prompt notifications; asked for when you turn them on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sets scheduled prompts again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lena's own timers and alarms: exact alarm clock times, the ringing as a foreground service that
         plays sound, and the ringing screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The same on Android 12, before USE_EXACT_ALARM existed (Android TV boxes; Android 11 needs neither). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Installing an update you downloaded in Settings > Software version > Updates (Android asks you to confirm each time). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android TV (docs/app/Android-TV.md): Lena runs there as the wall display, driven by the remote. None of
         these is needed, so phones, tablets and TVs all install the same app. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Lets Lena find the phone's speech recognizer and text-to-speech engine, and (dashboard
         mode's Apps button) the apps you can open. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- A TV's apps (the Apps button on a TV). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- allowBackup=false + extraction rules: your sign-in never goes to Google backups or phone-to-phone transfers. -->
    <application
        android:name=".LenaApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Lena">

        <!-- Don't send visited URLs to Google Safe Browsing, and opt out of WebView usage metrics. -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Dashboard mode: your Home Assistant dashboards in a Lena frame. It can be a tablet's
             home screen (Android settings > Apps > Default apps > Home app > Lena), and a TV's
             (tools/android-tv-home.sh).
             In the same task as the chat screen (one app in Recents). Its web view outlives the screen
             (DashboardWeb.kt), so coming back to Home doesn't load Home Assistant again. -->
        <activity
            android:name=".DashboardActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:exported="true"
            android:label="Lena dashboard"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- On Android TV, Lena's tile in the TV's apps opens the wall display: there's no chat on a TV. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lena's own chat, when Home Assistant's Assist answers instead of Open WebUI. -->
        <activity
            android:name=".AssistChatActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings > Logs. -->
        <activity android:name=".LogsActivity" android:exported="false" android:label="Logs" />

        <!-- Display mode: a clock, the weather and Lena, full screen and kept on. -->
        <activity
            android:name=".DisplayActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Lena display"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.soullink9.lena.display" />

        <!-- The same display as Android's screen saver (Settings > Display > Screen saver). -->
        <service
            android:name=".LenaDream"
            android:exported="true"
            android:label="Lena"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/lena_dream" />
        </service>

        <!-- The Ask sheet. Handles the assistant gesture (it can also hand off to a new chat)
             and "Share to Lena". Shared text only fills the box; nothing is sent until you tap send. -->
        <activity
            android:name=".AskActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Lena.Sheet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- All chats: pinned, folders and history, opened from the drawer. -->
        <activity
            android:name=".ChatsActivity"
            android:exported="false" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".LenaTile"
            android:exported="true"
            android:icon="@drawable/ic_glyph_talk"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".LenaWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lena_widget_info" />
        </receiver>

        <!-- Lets the camera app save one photo for the Ask sheet into Lena's private cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/photo_paths" />
        </provider>

        <receiver android:name=".ScheduleReceiver" android:exported="false" />
        <!-- Android's installer reports an update's progress here. -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <!-- Lena's timers and alarms: Android's alarm clock fires the receiver, the service rings, and the
             screen shows what's ringing with Stop and Snooze. -->
        <receiver android:name=".CountdownReceiver" android:exported="false" />
        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
