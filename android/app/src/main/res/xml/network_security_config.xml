<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Trusts normal certificates plus any CA you installed on the phone yourself
     (for a homelab certificate authority). Remove the "user" line if you only use public certificates. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
