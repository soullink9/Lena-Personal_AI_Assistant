<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for these. Your quick prompts are added beside them. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:enabled="true" android:icon="@drawable/ic_shortcut_talk"
        android:shortcutId="talk" android:shortcutShortLabel="@string/shortcut_talk">
        <intent android:action="io.github.soullink9.lena.TALK"
            android:targetClass="io.github.soullink9.lena.AskActivity"
            android:targetPackage="io.github.soullink9.lena" />
    </shortcut>
    <shortcut android:enabled="true" android:icon="@drawable/ic_shortcut_ask"
        android:shortcutId="ask" android:shortcutShortLabel="@string/shortcut_ask">
        <intent android:action="io.github.soullink9.lena.ASK"
            android:targetClass="io.github.soullink9.lena.AskActivity"
            android:targetPackage="io.github.soullink9.lena" />
    </shortcut>
    <shortcut android:enabled="true" android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings" android:shortcutShortLabel="@string/shortcut_settings">
        <intent android:action="io.github.soullink9.lena.SETTINGS"
            android:targetClass="io.github.soullink9.lena.MainActivity"
            android:targetPackage="io.github.soullink9.lena" />
    </shortcut>
</shortcuts>
