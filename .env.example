# Environment variables Lena's parts read. Copy what you need into your own .env (which git
# ignores) or into your container's environment. Nothing in this repository needs a secret to be
# committed: tokens and passwords for Home Assistant and Open WebUI are entered in their apps
# (the app keeps them encrypted on the device; Open WebUI keeps the filter's token on the server).

# ---- Building a signed APK yourself (android/app/build.gradle.kts) ----------------------------
# GitHub Actions takes these from the repository secrets KEYSTORE_B64 and KEYSTORE_PASSWORD.
# Without them the build is signed with the debug key, which can't update a release-signed install.
LENA_KEYSTORE=/path/to/lena-release.jks
LENA_KEYSTORE_PASSWORD=

# ---- Voice bridge (voice/bridge/compose.yaml) ---------------------------------------------
PIPER_HOST=wyoming-piper
PIPER_PORT=10200
# Default voice, as named in Piper (optional).
PIPER_VOICE=
# Leave WHISPER_HOST empty to turn speech-to-text off.
WHISPER_HOST=wyoming-whisper
WHISPER_PORT=10300
WHISPER_LANGUAGE=en
# If set, callers must send "Authorization: Bearer <API_KEY>" (set the same key in Open WebUI).
API_KEY=
PORT=8000
# Seconds before a Piper, Whisper or ffmpeg call gives up.
TIMEOUT=120

# ---- Open WebUI server (not part of this repository) ---------------------------------------
# Set a fixed, long random value so restarting Open WebUI doesn't sign every device out.
WEBUI_SECRET_KEY=
