<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for these; drag "Call" onto the home screen for one-tap calls. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_call"
        android:shortcutId="call"
        android:shortcutShortLabel="@string/shortcut_call">
        <intent
            android:action="io.github.soullink9.lena.CALL"
            android:targetClass="io.github.soullink9.lena.MainActivity"
            android:targetPackage="io.github.soullink9.lena" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="io.github.soullink9.lena.SETTINGS"
            android:targetClass="io.github.soullink9.lena.MainActivity"
            android:targetPackage="io.github.soullink9.lena" />
    </shortcut>
</shortcuts>
