# Lena's default settings
#
# Where each setting starts on a new install, and what Settings → Software version → Return to defaults goes back to.
#
# To change one: type one of its possible values after its = sign, exactly as listed (no quotes needed),
# and commit. Leave every other setting empty. Before the next build the change is applied: it becomes
# the "Current default" and the value after = is emptied again. See README.md in this folder.

# Connections › Who answers › Lena answers through
# Only for new installs: Return to defaults leaves it as it is.
# Possible values: Open WebUI | Home Assistant Assist
# Current default: Open WebUI
ANSWERS=

# Connections › Model › Her context size
# Only for new installs: Return to defaults leaves it as it is.
# Possible values: a whole number from 2048 to 1048576
# Current default: 32768
CONTEXT_TOKENS=

# Wall display › Screensaver › Screen saver after
# Possible values: 30 seconds | 1 minute | 2 minutes | 5 minutes | 10 minutes | 15 minutes | 30 minutes | 1 hour | Never
# Current default: 2 minutes
DIM_SECONDS=

# Wall display › Screensaver › Back from your chats after
# Possible values: 30 seconds | 1 minute | 2 minutes | 5 minutes | 10 minutes | Never
# Current default: 1 minute
RETURN_SECONDS=

# Wall display › Screensaver › Each photo for
# Possible values: 5 seconds | 10 seconds | 15 seconds | 30 seconds | 1 minute | 5 minutes
# Current default: 1 minute
SLIDE_SECONDS=

# Wall display › Screensaver › Transition
# Possible values: Fade | Slide | Slow zoom and fade | None
# Current default: Fade
SLIDE_TRANSITION=

# Wall display › Screensaver › Shuffle
# Possible values: On | Off
# Current default: On
SLIDE_SHUFFLE=

# Wall display › Screensaver › Fit
# Possible values: Smart | Fill the screen | Whole photo
# Current default: Smart
SLIDE_FRAMING=

# Wall display › Screensaver › Time and her mood on top
# Possible values: On | Off
# Current default: On
SLIDE_OVERLAY=

# Wall display › Screensaver › Her dim clock at night
# Possible values: On | Off
# Current default: On
SLIDE_CLOCK_AT_NIGHT=

# Talking to Lena › Wake word › Listen for her name
# Only for new installs: Return to defaults leaves it as it is.
# Possible values: On | Off
# Current default: Off
WAKE_WORD=

# Talking to Lena › Wake word › Listens
# Possible values: Only on the wall display | Whenever Lena is open
# Current default: Whenever Lena is open
WAKE_EVERYWHERE=

# Talking to Lena › Wake word › Her name
# Possible values: Hey Lena | Lena | Hey Jarvis | Okay Nabu | Hey Mycroft | Alexa | Hey Home Assistant
# Current default: Lena
WAKE_PHRASE=

# Talking to Lena › Wake word › How sure she must be
# Possible values: Fewer false starts | Balanced | Easier to wake
# Current default: Fewer false starts
WAKE_SENSITIVITY=

# Talking to Lena › How she looks and sounds › Her look
# Possible values: Orb | Sheet | Glow | Bar | Island | Subtitles
# Current default: Orb
ASK_STYLE=

# Talking to Lena › How she looks and sounds › Hearing you
# Possible values: On this phone | Your server
# Current default: On this phone
HEARING=

# Talking to Lena › How she looks and sounds › Her voice
# Possible values: Your server's voice | The phone's voice | Don't read replies aloud
# Current default: Your server's voice
SPEAKING=

# Talking to Lena › How she looks and sounds › Her voice follows her mood
# Possible values: On | Off
# Current default: Off
MOOD_VOICE=

# Talking to Lena › How she looks and sounds › Adjust her volume
# Possible values: On | Off
# Current default: On
AUTO_VOLUME=

# Talking to Lena › How she looks and sounds › Keep listening
# Possible values: After every reply | When she asks a question | Off
# Current default: After every reply
FOLLOW_UP=

# Talking to Lena › Interacting with Lena › The assistant gesture opens
# Possible values: Talk to Lena | Type to Lena | New chat
# Current default: Talk to Lena
ASSIST=

# Talking to Lena › Interacting with Lena › On the lock screen
# Possible values: On | Off
# Current default: Off
LOCK_SCREEN=

# Chat screen configuration › Chat screen › Lena's look
# Possible values: On | Off
# Current default: On
LENA_LOOK=

# Chat screen configuration › Chat screen › Open WebUI's own menus
# Possible values: On | Off
# Current default: Off
OPEN_WEBUI_MENUS=

# Chat screen configuration › Chat screen › Chat | Home switch
# Possible values: On | Off
# Current default: On
HOME_SWITCH=

# Chat screen configuration › Chat screen › Pinned chats
# Possible values: 3 | 5 | 8 | 12
# Current default: 5
PINNED_SHOWN=

# Chat screen configuration › Chat screen › Folders
# Possible values: On | Off
# Current default: On
DRAWER_FOLDERS=

# Chat screen configuration › Chat screen › All chats list style
# Possible values: Slim groups | Rounded groups | Flat list | Title and time | Timeline | Folding days
# Current default: Slim groups
CHAT_LIST=

# Device customization › Notifications › Reply notifications
# Possible values: On | Off
# Current default: Off
NOTIFY_REPLIES=

# Device customization › Notifications › Alerts on this phone
# Possible values: On | Off
# Current default: Off
ALERTS=

# Device customization › Widgets & tile › Her mood on the widget
# Possible values: On | Off
# Current default: Off
WIDGET_MOOD=
